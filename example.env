# nextendo-bcat-nx - example configuration.
# Copy to ".env" and export these into the server's environment (it does not read
# .env itself). NEVER commit your real .env or the private signing key.

# --- Network ---
# The server's address (announced where relevant).
NEXTENDO_HOST=127.0.0.1
# BCAT HTTP port. sni-router sends the bcat-* hosts here (TLS passthrough), or set
# CERT_FILE/KEY_FILE below to terminate TLS here directly.
BCAT_PORT=8470
# Optional direct TLS (a cert for the bcat-*.cdn.nintendo.net names your clients
# trust). Leave empty when sni-router terminates TLS.
CERT_FILE=
KEY_FILE=

# --- Content + signing ---
# Delivery-cache content: BCAT_CONTENT/<titleid-hex>/<directory>/<file>, plus an
# optional per-title "passphrase" file. Captured game data; not in the repo.
BCAT_CONTENT=content
# The local RSA-2048 signing key (the replacement for Nintendo's). Generated on
# first run if absent; the matching public key is written as <file>.pub.{pem,der}
# for the bcat-mitm module. Keep the PRIVATE key secret.
BCAT_KEY_FILE=bcat_signing_key.pem
# Default passphrase when a title has no passphrase file (real values are
# title-specific and come from the game).
BCAT_PASSPHRASE=

# --- Monitoring ---
DASH_PORT=8099
DASH_TOKEN=change-me
